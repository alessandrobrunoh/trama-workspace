{
  "billing": "subscription",
  "subagents": {
    "max_running_per_thread": 4,
    "max_running_total": 8,
    "allow_builtin_subagents": false
  },
  "checkouts": {
    "mode": "copy_on_write",
    "exclude": []
  },
  "workspaces": [
    {
      "name": "LaFraternita",
      "permission_mode": "accept_edits",
      "repos": [
        { "name": "backend", "path": "/abs/path" },
        { "name": "frontend", "path": "/abs/path" }
      ]
    }
  ]
}
